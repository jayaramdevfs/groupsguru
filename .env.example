# GroupsGuru Production Environment Variables
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://localhost:5432/groupsguru_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<your-password>
JWT_SECRET=<generate-a-64-char-random-string>
JWT_EXPIRATION=86400000
RAZORPAY_KEY_ID=<your-live-razorpay-key>
RAZORPAY_KEY_SECRET=<your-live-razorpay-secret>
APP_CORS_ALLOWED_ORIGINS=https://groupsguru.in
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAME_SITE=Strict
SERVER_PORT=8080
NEXT_PUBLIC_API_BASE_URL=https://groupsguru.in
