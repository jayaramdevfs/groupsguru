  <question type="multichoice">
    <name><text>GG-S21-ECON-Q08</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Consider the following statements about Tenancy Reforms during the land reform era:
1. They aimed to provide security of tenure to the cultivating tenants against arbitrary eviction.
2. They recommended fixing the rent at completely equal shares (50-50) between the landlord and the tenant.
Which of the statements given above is/are correct?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! Statement 1 is correct. Statement 2 is incorrect; the national guidelines for tenancy reforms recommended that rent should not exceed 1/4th to 1/5th of the gross produce (20-25%), not 50%.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">2 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Both 1 and 2</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Neither 1 nor 2</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-ECON-M4-7-006</text></tag>
