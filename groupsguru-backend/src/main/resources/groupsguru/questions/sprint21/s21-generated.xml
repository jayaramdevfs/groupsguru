      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-ECON-Q09</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">While evaluating the multi-dimensional impact of Land Reforms in India, comparing the success of intermediary abolition with land ceilings yields which of the following definitive conclusions?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Both intermediary abolition and land ceilings were equally successful and met their redistributive targets.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Intermediary abolition was largely successful, while land ceilings had limited success due to vast legal loopholes and bureaucratic delays.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! Economic surveys and historians agree that the abolition of Zamindars (intermediaries) was the most successful aspect of land reforms. Conversely, land ceilings failed to yield significant surplus land due to benami transfers, poor land records, and political interference from landed elites.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Land ceilings successfully redistributed wealth to the landless Dalits, but intermediary abolition completely failed to confer rights to occupancy tenants.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Both programs failed because agriculture was moved from the State List to the Union List shortly after independence.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
