  <question type="multichoice">
    <name><text>GG-S21-ECON-Q02</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Match the following land reform acts/committees in Andhra Pradesh with their distinct features:
List-I:
A. The AP (Andhra Area) Estates Act, 1948
B. The AP Ceiling on Agricultural Holdings Act, 1961
C. The AP Land Reforms Act, 1973
D. Koneru Ranga Rao Committee, 2004

List-II:
1. Individual as the unit of application
2. Review of assigned lands and 1/70 Act implementation
3. Family as the unit of application
4. Abolition of Zamindari system</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">A-4, B-3, C-1, D-2</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">A-4, B-1, C-3, D-2</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The 1948 Act abolished Zamindari (A-4). The 1961 Act used the individual as the unit (B-1). The 1973 Act used the family as the unit (C-3). The Koneru Ranga Rao Committee evaluated land assignments to the poor (D-2).</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">A-2, B-1, C-3, D-4</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">A-1, B-4, C-2, D-3</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
