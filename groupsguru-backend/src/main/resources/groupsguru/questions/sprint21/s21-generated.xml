  </question>

  <question type="multichoice">
    <name><text>GG-S21-ECON-Q04</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Why were the various Land Ceiling Acts passed by the respective state legislatures, including Andhra Pradesh, placed in the Ninth Schedule of the Indian Constitution?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To exempt agricultural income from income tax calculations.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To mandate the central government to fund the land redistribution processes.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To protect them from being challenged in judicial courts on the grounds of violating Fundamental Rights.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! placing land reform legislations in the Ninth Schedule protected them from judicial review under Article 31B, specifically protecting them from being struck down for violating Fundamental Rights such as the Right to Property (Article 31, before its repeal).</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To automatically transfer the subject of land from the State List to the Concurrent List.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-ECON-M4-7-006</text></tag>
      <tag><text>subject:Economy</text></tag>
      <tag><text>difficulty:hard</text></tag>
      <tag><text>cognitive_level:L3</text></tag>
      <tag><text>question_type:ANALYTICAL</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-ECON-Q05</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Which of the following is NOT a prominent reason for the failure or limited success of the 1961 AP Ceiling on Agricultural Holdings Act?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The unit of application for the ceiling was the individual rather than the family.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The ceiling limits set were excessively high, leaving very little surplus land.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The Act provided numerous exemptions for orchards, specialized farms, and trusts.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The Act strictly prohibited benami transactions and confiscated all such lands immediately.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The Act failed precisely because benami transfers (transferring land to fictitious names or distant relatives) were rampant, and the law did not effectively curb or strictly confiscate them. Statements (a), (b), and (c) represent genuine loopholes that caused the 1961 Act to fail.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-ECON-M4-7-006</text></tag>
      <tag><text>subject:Economy</text></tag>
      <tag><text>difficulty:medium</text></tag>
      <tag><text>cognitive_level:L2</text></tag>
      <tag><text>question_type:ELIM</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-ECON-Q06</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Under the AP Land Reforms (Ceiling on Agricultural Holdings) Act of 1973, what is the approximate statutory ceiling limit prescribed for 'dryland' for a standard family unit consisting of five members?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">10 to 15 acres</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">35 to 54 acres</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The 1973 Act prescribes standard holding limits ranging from 10 to 27 acres for wetland (depending on irrigation class) and 35 to 54 acres for dryland.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">5 to 10 acres</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">100 to 120 acres</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
