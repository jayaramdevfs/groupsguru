<quiz>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q01</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">The restriction endonuclease EcoRI recognises the specific palindromic nucleotide sequence in DNA. Which of the following is the correct sequence?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">5' - GATATC - 3'</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">5' - GAATTC - 3'</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! EcoRI specifically recognises the palindromic sequence 5'-GAATTC-3' and cuts between G and A. The other sequences are recognised by different restriction enzymes.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">5' - GTATAC - 3'</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">5' - GGATCC - 3'</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:easy</text></tag>
      <tag><text>cognitive_level:L1</text></tag>
      <tag><text>question_type:STATIC</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q02</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Consider the following statements regarding the Polymerase Chain Reaction (PCR):
1. The denaturation step is carried out at a high temperature (around 94°C) to separate the two strands of DNA.
2. DNA polymerase isolated from E. coli is used for the extension step because of its high efficiency.
3. The process of DNA replication in PCR is repeated many times to amplify the DNA segment.
Which of the statements given above are correct?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1 and 2 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">2 and 3 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1 and 3 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! Statement 1 is correct. Statement 2 is incorrect because the DNA polymerase used in PCR is Taq polymerase, isolated from the thermophilic bacterium Thermus aquaticus, as it remains active during high temperatures. Statement 3 is correct as the goal of PCR is amplification.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1, 2 and 3</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:medium</text></tag>
      <tag><text>cognitive_level:L2</text></tag>
      <tag><text>question_type:STMT</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q03</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">In the context of genetically modified crops, what is the primary mechanism of action of the Bt toxin?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It inhibits the photosynthesis process in the insect pests.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It creates pores in the midgut epithelial cells of the insect, leading to cell lysis.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The Bt toxin is ingested in its inactive form. The alkaline pH of the insect's gut solubilises the crystals into an active toxin. This active toxin binds to the surface of midgut epithelial cells and creates pores that cause cell swelling and lysis, eventually causing the death of the insect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It blocks the respiratory chain in the mitochondria of pests.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It acts as a neurotoxin that paralyzes the insect's nervous system.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:medium</text></tag>
      <tag><text>cognitive_level:L2</text></tag>
      <tag><text>question_type:STATIC</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q04</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Consider the following matched pairs regarding biotechnology processes:
1. Gel Electrophoresis : Separation of DNA fragments based on size
2. DNA Ligase : Cutting DNA into small fragments
3. Ethidium Bromide : Visualisation of DNA fragments
4. Downstream Processing : Separation and purification of products
Which of the pairs given above are correctly matched?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1, 2 and 3</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1, 3 and 4</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! DNA Ligase is used to join DNA fragments, not cut them. Restriction endonucleases are used for cutting. The other pairs are correctly matched.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">2, 3 and 4</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1, 2, 3 and 4</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:medium</text></tag>
      <tag><text>cognitive_level:L2</text></tag>
      <tag><text>question_type:MATCH</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q05</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Which of the following is NOT a correct statement regarding the application of RNA interference (RNAi)?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It is a method of cellular defense present in all eukaryotic organisms.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It involves the silencing of a specific mRNA due to a complementary dsRNA molecule.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">It has been primarily used to develop tobacco plants resistant to the nematode Meloidegyne incognita.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The technique requires the use of Agrobacterium vectors to introduce restriction enzymes into the host plant.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! RNAi technique uses Agrobacterium vectors to introduce nematode-specific genes into the host plant to produce both sense and antisense RNA, which form the dsRNA that triggers RNAi. It does not introduce restriction enzymes for this purpose. The other statements are correct.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:hard</text></tag>
      <tag><text>cognitive_level:L3</text></tag>
      <tag><text>question_type:ELIM</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q06</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Compared to the maturation of human insulin in the body, the genetically engineered insulin produced by Eli Lilly using E. coli:</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Contains the extra C-peptide sequence that makes it more stable.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Is synthesised directly without the C-peptide stretch by creating separate DNA sequences for A and B chains.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! In humans, insulin is synthesised as a pro-hormone containing an extra C-peptide, which is removed during maturation. Eli Lilly prepared two DNA sequences corresponding to A and B, chains of human insulin and introduced them in plasmids of E. coli to produce insulin chains separately, which were then extracted and combined by creating disulfide bonds.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Requires post-translational modification inside the bacterial host to join the A, B, and C chains.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Is identical to pro-insulin and needs to be activated in the human bloodstream.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:hard</text></tag>
      <tag><text>cognitive_level:L3</text></tag>
      <tag><text>question_type:ANALYTICAL</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q07</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Consider the following statements regarding the Genetic Engineering Appraisal Committee (GEAC):
1. It is the apex body in India under the Ministry of Environment, Forest and Climate Change.
2. It takes decisions regarding the validity of GM research and the safety of introducing GM-organisms for public services.
Which of the statements given above is/are correct?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">1 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">2 only</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Both 1 and 2</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The Indian Government has set up organisations such as GEAC, which makes decisions regarding the validity of GM research and the safety of introducing GM-organisms for public services. Both statements accurately reflect its role and administrative authority.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Neither 1 nor 2</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:easy</text></tag>
      <tag><text>cognitive_level:L2</text></tag>
      <tag><text>question_type:STMT</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q08</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">Which among the following human diseases was the first clinical gene therapy given for in 1990?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Emphysema</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Cystic Fibrosis</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Adenosine Deaminase (ADA) deficiency</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The first clinical gene therapy was given in 1990 to a 4-year-old girl with adenosine deaminase (ADA) deficiency, a crucial enzyme for the immune system to function.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Phenylketonuria</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:easy</text></tag>
      <tag><text>cognitive_level:L1</text></tag>
      <tag><text>question_type:STATIC</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-SCI-Q09</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">In the context of the controversy surrounding naturally occurring biological resources, what does the term 'Biopiracy' refer to?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The unauthorized production of generic medicines by developing nations without paying royalties.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The theft of laboratory-created recombinant DNA plasmids by rival pharmaceutical companies.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The use of bio-resources by multinational companies without proper authorization from the countries and people concerned.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! Biopiracy is the term used to refer to the use of bio-resources by multinational companies and other organisations without proper authorisation from the countries and people concerned without compensatory payment. Examples include US patents filed for traditional Indian resources like Basmati rice, Neem, and Turmeric.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The deliberate release of genetically modified organisms into the wild to alter ecosystems.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <tags>
      <tag><text>micro_topic_id:MT-SCI-M5-7-001</text></tag>
      <tag><text>subject:Science</text></tag>
      <tag><text>difficulty:medium</text></tag>
      <tag><text>cognitive_level:L2</text></tag>
      <tag><text>question_type:STATIC</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

