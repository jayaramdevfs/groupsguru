    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-ECON-Q07</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">In the context of agrarian reforms in Andhra Pradesh, what was the primary purpose of the '1/70 Act' (AP Scheduled Areas Land Transfer Regulation Amendment, 1970)?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To ensure that one-seventieth (1/70) of all state revenue is allocated to tribal welfare.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To establish maximum ceiling limits on tribal agricultural holdings.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To prohibit and nullify the transfer of land in Scheduled Areas from tribals to non-tribals.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The 1/70 Act strictly prohibits the transfer of land in the Scheduled Areas to non-tribals. Any transfer, whether from a tribal or a non-tribal situated in these areas, can only be made to a tribal. This protects Adivasis from land alienation.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">To regularize encroached forest lands for tribal communities.</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
