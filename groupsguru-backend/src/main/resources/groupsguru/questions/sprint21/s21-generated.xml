      <tag><text>question_type:ANALYTICAL</text></tag>
      <tag><text>sprint:S21</text></tag>
    </tags>
  </question>

  <question type="multichoice">
    <name><text>GG-S21-ECON-Q10</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">The digital land records portal developed by the Government of Andhra Pradesh to provide transparent access to land passbooks and Adangal details is known as:</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Dharani</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Mee Bhoomi</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! 'Mee Bhoomi' is the specialized digital land record portal implemented by the Andhra Pradesh government. (Dharani is for Telangana; Bhoomi is for Karnataka).</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Bhoomi</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">E-Panta</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
