  <question type="multichoice">
    <name><text>GG-S21-ECON-Q01</text></name>
    <questiontext format="html">
      <text><![CDATA[<p><span lang="en" class="multilang">According to the AP Land Reforms (Ceiling on Agricultural Holdings) Act of 1973, what is the 'Family Unit' typically defined as for calculating ceiling limits?</span></p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <penalty>0.25</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>ABCD</answernumbering>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">An individual adult, regardless of marital status</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Husband, wife, and their unmarried minor children up to 5 members</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Correct! The 1973 Act plugged loopholes from the 1961 Act by defining the 'Family Unit' as consisting of husband, wife, and minor children, up to a maximum of 5 members. For families larger than 5, an additional increment was allowed up to a maximum limit.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">The entire joint family including grandparents and married siblings</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<span lang="en" class="multilang">Husband, wife, and all unmarried children regardless of age</span>]]></text>
      <feedback format="html"><text><![CDATA[<span lang="en" class="multilang">Incorrect.</span>]]></text></feedback>
    </answer>
